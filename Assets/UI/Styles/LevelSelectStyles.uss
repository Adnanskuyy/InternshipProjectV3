.container {
    flex-grow: 1;
    background-color: rgb(34, 34, 34);
}

.header {
    flex-direction: row;
    align-items: center;
    padding: 20px;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(34, 34, 34, 0.8);
}

.title {
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    margin-left: 20px;
}

.back-btn {
    padding: 10px 20px;
    font-size: 18px;
    background-color: rgb(68, 68, 68);
    color: white;
    border-radius: 8px;
    border-width: 0;
}

.back-btn:hover {
    background-color: rgb(85, 85, 85);
}

.map-scrollview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.map-container {
    width: 1920px;
    height: 1080px;
    position: relative;
    background-image: url('../../Art/MapBackground.svg');
    -unity-background-scale-mode: stretch-to-fill;
}

.level-node {
    position: absolute;
    width: 100px;
    height: 100px;
    transform-origin: center;
    scale: 0;
    transition-property: scale;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-elastic;
}

.level-node.show {
    scale: 1;
}

.level-btn {
    width: 100px;
    height: 100px;
    border-radius: 50px;
    border-width: 4px;
    border-color: white;
    justify-content: center;
    align-items: center;
    transition-duration: 0.2s;
    margin: 0;
    padding: 0;
}

.level-name {
    font-size: 24px;
    -unity-font-style: bold;
    color: white;
}

.unlocked-level {
    background-color: rgb(46, 204, 113);
    box-shadow: 0 0 15px rgba(46, 204, 113, 0.5);
}

.unlocked-level:hover {
    scale: 1.1;
    background-color: rgb(39, 174, 96);
    box-shadow: 0 0 25px rgba(46, 204, 113, 0.8);
}

.locked-level {
    background-color: rgb(127, 140, 141);
    border-color: rgb(149, 165, 166);
}

.locked-level .level-name {
    color: rgb(189, 195, 199);
}